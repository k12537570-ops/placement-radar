# Placement Radar Frontend Environment Variables
# ----------------------------------------------------
# In Local Development:
# Leave as /api/v1 (vite.config.js dev proxy automatically forwards /api to http://localhost:5000)
VITE_API_URL=/api/v1

# In Production on Vercel:
# Set VITE_API_URL in your Vercel Project Settings > Environment Variables:
# VITE_API_URL=https://your-backend-app.onrender.com/api/v1
