PORT=5000
NODE_ENV=development

# Database Configuration
# Local SQLite default:
DATABASE_URL="file:./dev.db"
# Persistent mount on Render/Railway:
# DATABASE_URL="file:/data/dev.db"
# Managed PostgreSQL migration:
# DATABASE_URL="postgresql://user:password@hostname:5432/dbname?schema=public"

# JWT Authentication Secrets (Replace with random 64-char strings in production)
JWT_ACCESS_SECRET="placement_radar_super_secret_access_jwt_key_2026"
JWT_REFRESH_SECRET="placement_radar_super_secret_refresh_jwt_key_2026"
ACCESS_TOKEN_EXPIRES_IN="15m"
REFRESH_TOKEN_EXPIRES_IN="7d"

# Allowed CORS Origins (comma-separated for multiple origins)
# In development: http://localhost:5173
# In production on Vercel: https://your-app.vercel.app (Note: any *.vercel.app domain is also auto-allowed)
CORS_ORIGIN="http://localhost:5173"
